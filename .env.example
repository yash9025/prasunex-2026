# LearningBridge Environment Configuration Template
# Copy this file to .env and configure values before starting the services

# Application Environment
APP_ENV=production
DEBUG=false
APP_NAME=LearningBridge

# Database Configuration (PostgreSQL in production; SQLite in local development)
DATABASE_URL=postgresql://postgres:PostgresSuperPassword2026!@localhost:5432/learningbridge
# Or local SQLite:
# DATABASE_URL=sqlite:///./learningbridge.db

# Message Broker & Distributed Cache
REDIS_URL=redis://localhost:6379/0

# Security & Signed Token Secret (Generate a strong 32+ character random key in production)
SECRET_KEY=learningbridge-production-secret-key-google-eval-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Optional: Google Gemini API Key for Intervention Drafting (Deterministic Template Fallback is active if omitted)
GEMINI_API_KEY=
